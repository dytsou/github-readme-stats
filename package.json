{
  "name": "@dytsou/github-readme-stats",
  "version": "1.4.1",
  "packageManager": "pnpm@10.33.0",
  "description": "Dynamically generate stats for your GitHub readme",
  "keywords": [
    "github-readme-stats",
    "readme-stats",
    "cards",
    "card-generator"
  ],
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./worker": "./src/worker.ts"
  },
  "files": [
    "src",
    "api",
    "themes",
    "LICENSE",
    "README.md",
    "openapi.yaml",
    "API.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/dytsou/github-readme-stats",
  "bugs": {
    "url": "https://github.com/dytsou/github-readme-stats/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dytsou/github-readme-stats.git"
  },
  "scripts": {
    "test": "mkdir -p .coverage-tmp coverage/.tmp && vitest run --coverage",
    "test:ci": "pnpm test && pnpm lint && pnpm format",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:update:snapshot": "vitest run -u",
    "test:e2e": "vitest run --config vitest.e2e.config.js",
    "theme-readme-gen": "node scripts/generate-theme-doc",
    "preview-theme": "node scripts/preview-theme",
    "close-stale-theme-prs": "node scripts/close-stale-theme-prs",
    "generate-langs-json": "node scripts/generate-langs-json",
    "generate-readme-samples": "vitest run --config vitest.generate-readme-samples.config.js",
    "update-license-year": "node scripts/update-license-year.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky && node scripts/generate-wrangler-config.js",
    "lint": "NPM_CONFIG_LOGLEVEL=error npx eslint --max-warnings 0 \"./src/**/*.js\" \"./scripts/**/*.js\" \"./tests/**/*.js\" \"./api/**/*.js\" \"./themes/**/*.js\"",
    "bench": "vitest run --config vitest.bench.config.js",
    "deploy": "node scripts/generate-wrangler-config.js && wrangler deploy",
    "deploy:preview": "node scripts/generate-wrangler-config.js && wrangler deploy --env preview",
    "deploy:workers-builds": "node scripts/generate-wrangler-config.js && wrangler versions upload",
    "build:api-docs": "node scripts/build-api-docs.js",
    "deploy:api-docs": "pnpm run build:api-docs && wrangler pages deploy publish --project-name=github-readme-stats-api-docs --branch=main",
    "publish:npmjs": "pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:github": "pnpm publish --access public --no-git-checks --registry https://npm.pkg.github.com",
    "publish:all": "pnpm run publish:npm && pnpm run publish:github"
  },
  "author": "dytsou",
  "license": "MIT",
  "devDependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0",
    "@redocly/cli": "^2.37.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/escape-html": "^1.0.4",
    "@uppercod/css-to-object": "^1.1.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "axios-mock-adapter": "^2.1.0",
    "color-contrast-checker": "^2.1.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "express": "^5.2.1",
    "globals": "^17.5.0",
    "happy-dom": "^20.9.0",
    "hjson": "^3.2.2",
    "husky": "^9.1.7",
    "js-yaml": "^5.2.2",
    "jsdom": "^30.0.0",
    "lint-staged": "^17.0.4",
    "lodash.snakecase": "^4.1.1",
    "parse-diff": "^0.12.0",
    "prettier": "^3.8.3",
    "vitest": "^4.1.4",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.0",
    "axios": "^1.15.0",
    "dotenv": "^17.4.2",
    "emoji-name-map": "^2.0.3",
    "escape-html": "^1.0.3",
    "github-username-regex": "^1.0.0",
    "hono": "^4.12.14",
    "word-wrap": "^1.2.5"
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "body-parser": ">=2.3.0",
      "qs": ">=6.15.2",
      "js-yaml@>=5": ">=5.2.2",
      "brace-expansion@>=5.0.0 <=5.0.8": "5.0.9",
      "undici@<6.27.0": ">=6.27.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "@actions/github>undici": "7.29.0",
      "@actions/http-client@4.0.1>undici": "7.29.0",
      "miniflare>undici": "7.29.0",
      "vite": "8.0.16",
      "launch-editor": ">=2.14.1"
    },
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
